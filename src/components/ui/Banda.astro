---
// Banda a todo el ancho de la ventana (fondo de borde a borde) con el contenido en el contenedor (90 rem, 16 px de
// margen en móvil). `color`: nieve (papel) | clara (papel-2, bajo una tabla o un formulario) | campo (el cobalto del
// acento, como mucho una por página) | noche (el primario).
interface Props { id?: string; color?: string; class?: string; etiqueta?: string; contenedor?: boolean }
const { id, color = 'nieve', class: clase = '', etiqueta, contenedor = true } = Astro.props;
---

<section id={id} class:list={['banda', `banda--${color}`, clase]} aria-label={etiqueta}>
  {contenedor ? <div class="contenedor"><slot /></div> : <slot />}
</section>
