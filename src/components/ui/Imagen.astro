---
// Imagen con carga diferida por defecto. `prioridad` para la de la portada (se carga al momento).
// Si una foto de /fotos/ todavía no existe o falla, se ve un respaldo plano de public/placeholders/.
interface Props { src?: string; alt?: string; ancho?: number; alto?: number; class?: string; prioridad?: boolean }
const { src, alt = '', ancho = 800, alto = 600, class: clase = '', prioridad = false } = Astro.props;
const respaldo = src && src.startsWith('/fotos/') ? (/\/hero\./.test(src) ? '/placeholders/hero.svg' : '/placeholders/foto.svg') : '';
const alFallar = respaldo ? `this.onerror=null;this.src='${respaldo}'` : undefined;
// `alt` vacío = foto decorativa (también aria-hidden). Las de contenido llevan su alt (src/lib/seo.ts: altHero, altFicha…).
---

{
  src && (
    <img
      src={src}
      alt={alt}
      aria-hidden={alt === '' ? 'true' : undefined}
      width={ancho}
      height={alto}
      class={clase}
      loading={prioridad ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={prioridad ? 'high' : undefined}
      onerror={alFallar}
    />
  )
}
