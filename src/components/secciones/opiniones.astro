---
// «Opiniones»: cabeza con filete de tinta y las opiniones en columnas, cada una bajo un filete de 2 px: la frase en
// Barlow a tamaño de entrada y la firma (autor y `nota`, p. ej. «Google») en letra menuda. Sin opiniones no se pinta.
// La plataforma no las inventa: van desmarcadas hasta que el cliente pone las suyas.
// Lista: `testimonios` [{ texto, autor, nota }].
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Banda from '../ui/Banda.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const lista = (s?.testimonios ?? []).filter((t) => t.texto);
---

{
  s && lista.length > 0 && (
    <Banda id={id} color="nieve">
      <Titular titulo={s.titulo} antetitulo={s.antetitulo} texto={s.texto} cabeza />
      <ul class="opiniones" style={`--n:${Math.min(lista.length, 3)}`}>
        {lista.map((t) => (
          <li>
            <blockquote class="opinion-texto">{t.texto}</blockquote>
            {(t.autor || t.nota) && (
              <p class="opinion-autor">
                {t.autor}
                {t.nota && <span class="opinion-nota">{t.autor ? `, en ${t.nota}` : t.nota}</span>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </Banda>
  )
}
